---
import Layout from '../../layouts/Layout.astro';
import MasonryGrid from '../../components/MasonryGrid.astro';
import photos from '../../data/photos/nature.json';
import { albumJsonLd } from '../../utils/seo';
---

<Layout
  title="Nature"
  description="Nature photography by Reuben Ingber — waterfalls, forests, and landscapes."
  canonicalPath="/nature"
  jsonLd={albumJsonLd('Nature', '/nature', photos)}
>
  <MasonryGrid photos={photos} />
</Layout>
