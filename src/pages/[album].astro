---
import Layout from '../layouts/Layout.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import { albums } from '../data/albums';
import { albumJsonLd } from '../utils/seo';

interface Photo {
  publicId: string;
  album: string;
  alt: string;
  width: number;
  height: number;
}

const photoModules = import.meta.glob<{ default: Photo[] }>('../data/photos/*.json', { eager: true });

export function getStaticPaths() {
  return albums.map(album => ({
    params: { album: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const photos = photoModules[`../data/photos/${album.slug}.json`]?.default ?? [];
const canonicalPath = `/${album.slug}`;
---

<Layout
  title={album.label}
  description={`${album.label} photography by Reuben Ingber.`}
  canonicalPath={canonicalPath}
  jsonLd={albumJsonLd(album.label, canonicalPath, photos)}
>
  <MasonryGrid photos={photos} />
</Layout>
